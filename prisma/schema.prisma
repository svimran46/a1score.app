datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Player {
  id              String               @id @default(cuid())
  fullName        String
  commonName      String?
  dateOfBirth     DateTime?
  nationality     String[]
  position        String
  subPosition     String?
  preferredFoot   String?
  heightCm        Int?
  photoUrl        String?
  apiFootballId   Int?                 @unique
  transfermarktId String?              @unique
  latestMarketValue BigInt?
  lastSeason      Int?
  status          String?              @default("first_team")
  currentClubId   String?
  currentClub     Club?                @relation("CurrentClubPlayers", fields: [currentClubId], references: [id])
  parentClubId    String?
  parentClub      Club?                @relation("ParentClubPlayers", fields: [parentClubId], references: [id])
  loanUntil       DateTime?
  marketValues    MarketValueHistory[]
  valueSnapshots  ValueSnapshot[]
  seasonStats     SeasonStats[]
  transfers       Transfer[]
  injuries        Injury[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([fullName])
  @@index([position])
  @@index([currentClubId])
  @@index([parentClubId])
  @@index([latestMarketValue])
  @@index([status])
}

model Club {
  id              String   @id @default(cuid())
  name            String
  code            String?
  logoUrl         String?
  country         String?
  transfermarktId String?  @unique
  totalMarketValue BigInt? @default(0)
  squadSize       Int?     @default(0)
  lastSeason      Int?
  lastSyncedAt    DateTime?
  squadSource     String?  @default("FotMob + Transfermarkt")
  leagueId        String?
  league          League?  @relation(fields: [leagueId], references: [id])
  players         Player[] @relation("CurrentClubPlayers")
  loanedOutPlayers Player[] @relation("ParentClubPlayers")
  competitionWinners CompetitionWinner[]
  honours         ClubHonour[]
  valueSnapshots  ClubValueSnapshot[]

  @@index([leagueId])
  @@index([name])
  @@index([totalMarketValue])
  @@index([lastSeason])
}

model League {
  id               String   @id @default(cuid())
  name             String
  country          String
  tier             Int?
  logoUrl          String?
  transfermarktId  String?  @unique
  totalMarketValue BigInt?  @default(0)
  totalPlayers     Int?     @default(0)
  clubCount        Int?     @default(0)
  clubs            Club[]
}

model MarketValueHistory {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  date      DateTime
  valueEur  BigInt
  clubName  String?

  @@index([playerId, date])
}

model Transfer {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromClubName String?
  toClubName   String?
  date         DateTime
  feeEur       BigInt?
  transferType String?  // "permanent" | "loan" | "free"

  @@index([playerId])
  @@index([date])
}

model SeasonStats {
  id            String  @id @default(cuid())
  playerId      String
  player        Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season        String  // e.g. "2024/2025"
  competition   String
  clubName      String
  appearances   Int?
  goals         Int?
  assists       Int?
  minutesPlayed Int?
  yellowCards   Int?
  redCards      Int?

  @@index([playerId, season])
}

model Injury {
  id        String    @id @default(cuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type      String
  startDate DateTime
  endDate   DateTime?
  status    String    // "active" | "recovered"

  @@index([playerId])
}

model Competition {
  id        String              @id @default(cuid())
  key       String              @unique
  label     String
  note      String?
  winners   CompetitionWinner[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model CompetitionWinner {
  id             String       @id @default(cuid())
  competitionKey String
  competition    Competition  @relation(fields: [competitionKey], references: [key], onDelete: Cascade)
  season         String       // e.g. "1888/89", "2025/26"
  seasonEndYear  Int          // e.g. 1889, 2026
  clubName       String
  clubId         String?
  club           Club?        @relation(fields: [clubId], references: [id])
  isExternal     Boolean      @default(false)
  source         String?
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([competitionKey, season])
  @@index([competitionKey])
  @@index([clubId])
  @@index([isExternal])
}

model ClubHonour {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  competitionKey  String   // e.g. "domestic_league", "ucl"
  competitionName String   // e.g. "Premier League", "UEFA Champions League"
  titleCount      Int
  seasons         Json     // array of season strings e.g. ["2023/24", "2022/23"]
  source          String?  @default("Transfermarkt")
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clubId, competitionKey])
  @@index([clubId])
  @@index([competitionKey])
}

model ValueSnapshot {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  valueEur  BigInt
  date      DateTime
  source    String   @default("Transfermarkt")
  createdAt DateTime @default(now())

  @@unique([playerId, date, source])
  @@index([playerId, date])
  @@index([date])
}

model ClubValueSnapshot {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  totalMarketValue BigInt
  squadSize        Int?
  date             DateTime
  source           String   @default("FotMob + Transfermarkt")
  createdAt        DateTime @default(now())

  @@unique([clubId, date, source])
  @@index([clubId, date])
  @@index([date])
}

