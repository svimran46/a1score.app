# systemd unit for LiveScore on a VPS (alternative to pm2).
#
#   sudo cp deploy/livescore.service /etc/systemd/system/
#   # If you cloned the repo somewhere other than /opt/livescore, fix the
#   # paths (and the User= line) with:
#   #   sudo systemctl edit livescore
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now livescore
#   systemctl status livescore
#
# See DEPLOYMENT.md for the full walkthrough.

[Unit]
Description=LiveScore (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/livescore
# Standalone entry point; binds 127.0.0.1:3000 (loopback, behind Caddy).
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=3
# Hardening: the app needs no privileges beyond reading its own files.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/livescore/.next

[Install]
WantedBy=multi-user.target
