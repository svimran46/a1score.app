# Caddyfile for LiveScore on a VPS
#
# Caddy provisions and renews Let's Encrypt certificates automatically —
# no certbot needed. Point a DNS A/AAAA record for $SITE_DOMAIN at the VPS
# before starting Caddy, then:
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo sed -i 's/\$SITE_DOMAIN/live.example.com/' /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# See DEPLOYMENT.md for the full walkthrough.

{$SITE_DOMAIN:live.example.com} {
	# Next.js standalone server (pm2/systemd) listens on 127.0.0.1:3000.
	reverse_proxy 127.0.0.1:3000

	encode gzip

	header {
		# Basic hardening; the app sets its own X-Frame-Options etc. via
		# next.config.ts headers(), Caddy adds transport-level extras.
		Strict-Transport-Security "max-age=31536000; include-subdomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
