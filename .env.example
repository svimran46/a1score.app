# -----------------------------------------------------------------------------
# a1score.app — Environment Configuration Template
# -----------------------------------------------------------------------------

# Supabase REST API & Client Credentials (Required)
# Used by runtime server components, edge route handlers, and client components.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-JWT]"

# Site Canonical & OpenGraph URL
# Used for canonical links, sitemaps, robots.txt, and metadata.
SITE_URL="https://a1score.app"
NEXT_PUBLIC_SITE_URL="https://a1score.app"

# Application Version
# Displayed in health check endpoint (/api/health) and telemetry.
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Cloudflare Image Optimization & Storage CDN (Optional)
# If using Cloudflare Images / Image Resizing edge transform:
NEXT_PUBLIC_CF_IMAGE_RESIZING="false"
# Optional Cloudflare R2 or custom CDN bucket URL for static club crests and player photos:
# NEXT_PUBLIC_R2_URL="https://assets.a1score.app"

# Direct Database Connection (Optional / Developer Scripts Only)
# Used only by local migration/data ingestion scripts via Prisma.
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
