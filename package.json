    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "5.22.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.24",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.141.0"
  }
