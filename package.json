    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "sync:dataset": "tsx scripts/sync-dataset.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "verify:data": "tsx scripts/verify-data-integrity.ts",
    "check:integrity": "tsx scripts/nightly-integrity-check.ts",
    "reconcile:squads": "tsx scripts/reconcile-all-transfers.ts",
    "export:data": "tsx scripts/export-dataset.ts",
    "check:rls": "tsx scripts/check-rls.ts",
    "test:unit": "tsx --test tests/pure-functions.test.ts tests/positions.test.ts tests/image-proxy.test.ts tests/navbar-active.test.ts tests/cache.test.ts tests/health.test.ts",
    "test:integrity": "tsx --test tests/integrity.test.ts",
    "test": "npm run test:unit && npm run test:integrity"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "csv-parse": "^5.5.6",
